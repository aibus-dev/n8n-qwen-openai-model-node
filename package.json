{
	"name": "n8n-nodes-azbot-qwen-model",
	"version": "0.1.0",
	"description": "n8n community node for a Qwen Cloud (DashScope) / OpenAI-compatible Chat Model with built-in JSON Schema structured output",
	"license": "MIT",
	"homepage": "https://github.com/aibus-dev/n8n-qwen-openai-model-node",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "AZBOT",
		"email": "contact@aibus.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/aibus-dev/n8n-qwen-openai-model-node.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/QwenApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/QwenChatModel/QwenChatModel.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	}
}
