{
	"name": "@aibus/n8n-nodes-qwen-model",
	"version": "0.1.5",
	"description": "n8n community node for a Qwen Cloud (DashScope) / OpenAI-compatible Chat Model with built-in JSON Schema structured output",
	"license": "MIT",
	"homepage": "https://github.com/aibus-dev/n8n-qwen-openai-model-node",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "AZBOT",
		"email": "contact@aibus.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aibus-dev/n8n-qwen-openai-model-node.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test tests/*.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/QwenApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/QwenChatModel/QwenChatModel.node.js"
		]
	},
	"devDependencies": {
		"@n8n/ai-node-sdk": "0.24.2",
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"n8n-workflow": "2.34.2",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"zod": "3.25.76"
	},
	"peerDependencies": {
		"@n8n/ai-node-sdk": "*",
		"n8n-workflow": "*"
	}
}
